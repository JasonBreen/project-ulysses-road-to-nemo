# Keep Paradox text sources diffable and avoid accidental binary normalization.
*.txt text eol=lf
*.lua text eol=lf
*.mod text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.csv text eol=lf
# Reproducible authored GUI and packaging sources use the same bytes on CI.
*.gui text eol=lf
*.gfx text eol=lf
*.py text eol=lf
*.json text eol=lf
*.bmp binary
*.dds binary
*.png binary
*.wav binary
# Generated map metrics have a byte-pinned manifest on Windows and Linux.
mod/2985041246/gfx/fonts/hoi_mapfont4.fnt text eol=lf
# Byte-reproducible Usean partner authoring and presentation outputs.
tools/usean_partners/** text eol=lf
mod/2985041246/interface/ac_usean_partners.gfx text eol=lf
docs/evidence/usean-partners/*.html text eol=lf
# Compact decision-row sources and reproducible offline review index.
tools/decision_row_art/** text eol=lf
docs/evidence/decision-rows/*.html text eol=lf
