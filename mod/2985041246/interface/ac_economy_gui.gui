guiTypes = {
	# Independent quick launcher, anchored to the game HUD instead of politics_tab.
	containerWindowType = {
		name = "project_ulysses_economy_screen_open_button"
		position = { x = -96 y = -96 }
		orientation = LOWER_RIGHT
		size = { width = 64 height = 64 }
