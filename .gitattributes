# Keep Paradox text sources diffable and avoid accidental binary normalization.
*.txt text eol=lf
*.lua text eol=lf
*.mod text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.csv text eol=lf
# Reproducible authored GUI and packaging sources use the same bytes on CI.
*.gui text eol=lf
*.gfx text eol=lf
*.py text eol=lf
*.json text eol=lf
# Generated map metrics have a byte-pinned manifest on Windows and Linux.
mod/2985041246/gfx/fonts/hoi_mapfont4.fnt text eol=lf
# Reused authored research font metrics have portable exact provenance hashes.
mod/2985041246/gfx/fonts/ACBriefing16.fnt text eol=lf
mod/2985041246/gfx/fonts/ACBriefing20.fnt text eol=lf
# Byte-reproducible Usean partner authoring and presentation outputs.
tools/usean_partners/** text eol=lf
mod/2985041246/interface/ac_usean_partners.gfx text eol=lf
docs/evidence/usean-partners/*.html text eol=lf
# Preserve inherited spacing in immutable authoring-input captures. Delivered
# mod files and generated output retain the normal whitespace checks above.
tools/world_legacy/baseline/** -whitespace
# Reproducible original LAND masters and immutable pre-change GUI contract.
tools/land_program/** text eol=lf
tools/land_program/source/research_base.gui -whitespace
# Compact decision-row sources and reproducible offline review index.
tools/decision_row_art/** text eol=lf
docs/evidence/decision-rows/*.html text eol=lf
# Reproducible original aviation masters and immutable LAND-page capture.
tools/air_program/** text eol=lf
tools/air_program/source/research_land_base.gui -whitespace
docs/evidence/air-program/*.html text eol=lf
# Binary masters must override every preceding folder-wide text rule.
*.[bB][mM][pP] binary -eol
*.[dD][dD][sS] binary -eol
*.[pP][nN][gG] binary -eol
*.[tT][gG][aA] binary -eol
*.[wW][aA][vV] binary -eol
*.[tT][tT][fF] binary -eol
*.[oO][tT][fF] binary -eol
*.[jJ][pP][gG] binary -eol
*.[jJ][pP][eE][gG] binary -eol
*.[wW][eE][bB][pP] binary -eol
*.[oO][gG][gG] binary -eol
